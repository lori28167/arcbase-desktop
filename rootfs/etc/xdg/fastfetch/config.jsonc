// Arcbase Desktop — configurazione di sistema di fastfetch.
// Per personalizzarla: fastfetch --gen-config (crea ~/.config/fastfetch/config.jsonc)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/arcbase/fastfetch/arcbase.txt",
        "color": {
            "1": "38;2;140;82;255",
            "2": "38;2;243;241;247"
        },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "color": {
            "keys": "38;2;140;82;255",
            "title": "38;2;197;165;255"
        },
        "separator": "  "
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "format": "{pretty-name} {arch}" },
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "theme",
        "icons",
        "font",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "locale",
        "break",
        "colors"
    ]
}
