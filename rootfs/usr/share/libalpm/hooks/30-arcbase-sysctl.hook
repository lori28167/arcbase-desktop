# Arcbase Desktop — hook ALPM
# (equivalente agli hook del pacchetto systemd di Arch, che qui è fornito dal base LFS)
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/sysctl.d/*

[Action]
Description = Applicazione dei parametri sysctl...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/arcbase-systemd-hook sysctl
