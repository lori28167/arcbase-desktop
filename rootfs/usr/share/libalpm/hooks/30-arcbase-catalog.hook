# Arcbase Desktop — hook ALPM
# (equivalente agli hook del pacchetto systemd di Arch, che qui è fornito dal base LFS)
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/systemd/catalog/*

[Action]
Description = Aggiornamento del catalogo del journal...
When = PostTransaction
Exec = /usr/bin/journalctl --update-catalog
