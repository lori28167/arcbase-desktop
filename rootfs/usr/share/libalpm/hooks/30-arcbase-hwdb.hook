# Arcbase Desktop — hook ALPM
# (equivalente agli hook del pacchetto systemd di Arch, che qui è fornito dal base LFS)
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/udev/hwdb.d/*

[Action]
Description = Aggiornamento del database hardware udev...
When = PostTransaction
Exec = /usr/bin/systemd-hwdb --usr update
