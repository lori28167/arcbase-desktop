# Arcbase Desktop — hook ALPM
# (equivalente agli hook del pacchetto systemd di Arch, che qui è fornito dal base LFS)
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/sysusers.d/*.conf

[Action]
Description = Creazione degli utenti di sistema...
When = PostTransaction
Exec = /usr/bin/systemd-sysusers
