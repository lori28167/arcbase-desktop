#!/bin/bash
# =============================================================================
#  arcbase-abi-check — verifica che i binari ELF trovino le loro librerie
#
#  Legge percorsi (relativi a /, come li passa pacman con NeedsTargets) da
#  stdin e segnala i binari con librerie mancanti o simboli versionati
#  assenti (tipicamente GLIBC_2.xx / GLIBCXX_3.4.xx più recenti del base LFS).
#  Usato dall'hook ALPM arcbase-abi-check.hook e da `arc doctor --abi`.
#
#  Uso: ... | arcbase-abi-check [--report]
#  Esce sempre con 0 come hook (non blocca le transazioni); con --report
#  esce con 1 se trova problemi.
# =============================================================================
set -o nounset -o pipefail

report=0
[[ ${1:-} == --report ]] && report=1
problems=0
max=${ARC_ABI_MAX_REPORT:-20}

is_elf() { [[ $(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n') == 7f454c46 ]]; }

while IFS= read -r rel; do
    f="/${rel#/}"
    [[ -f $f && ! -L $f ]] || continue
    case $f in
        # (in un pattern di case "*" comprende anche "/": include le sottodirectory)
        /usr/bin/*|/usr/libexec/*|/usr/lib/*.so|/usr/lib/*.so.*) ;;
        *) continue ;;
    esac
    is_elf "$f" || continue
    out=$(LC_ALL=C ldd "$f" 2>&1 | grep -E 'not found') || continue
    problems=$((problems + 1))
    if (( problems <= max )); then
        echo "  $f:"
        printf '%s\n' "$out" | sed 's/^[[:space:]]*/      /' | sort -u | head -n 5
    fi
done

if (( problems > 0 )); then
    (( problems > max )) && echo "  ... e altri $((problems - max)) file"
    echo "==> ATTENZIONE: $problems binari hanno dipendenze non soddisfatte."
    echo "    Se mancano simboli GLIBC/GLIBCXX esegui: sudo arc sync-runtime"
    (( report )) && exit 1
fi
exit 0
