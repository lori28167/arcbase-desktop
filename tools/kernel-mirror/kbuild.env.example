# =============================================================================
#  /etc/arcbase-kbuild.env — segreti di arcbase-kbuild (permessi 600, utente arcbuild)
#  Non copiarlo nel repository git e non condividerlo.
#
#  1. scrivi a @BotFather su Telegram: /newbot -> ricevi il token
#  2. manda un messaggio qualsiasi al tuo bot
#  3. apri https://api.telegram.org/bot<TOKEN>/getUpdates e copia "chat":{"id":...}
#  4. prova: sudo -u arcbuild arcbase-kbuild notify-test
# =============================================================================
KB_TELEGRAM_TOKEN=""
KB_TELEGRAM_CHAT=""

# Token GitHub per pubblicare i kernel (solo con KB_PUBLISH=github):
# github.com -> Settings -> Developer settings -> Fine-grained tokens -> Generate
#   Repository access: Only select repositories -> arcbase-kernel
#   Permissions: Contents -> Read and write        (nient'altro)
KB_GITHUB_TOKEN=""
